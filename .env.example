APP_NAME="SIABSEN SMKN 1 Sindang"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Kosong/false di dev lokal (biasanya HTTP polos) supaya cookie sesi tetap
# terkirim. WAJIB diisi true di production/Railway (selalu HTTPS) --
# tanpa ini cookie sesi bisa terkirim lewat koneksi tidak terenkripsi.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Token device Fonnte (https://fonnte.com) - kosongkan untuk menonaktifkan
# kanal WhatsApp (notifikasi tetap jalan lewat email seperti biasa).
FONNTE_TOKEN=

# Rollout bertahap: alpha aktif duluan (volume kecil). Ubah ke true kalau
# nomor WA sudah "hangat" & siap dipakai untuk notifikasi kehadiran juga
# (volume tinggi, burst tiap pagi - lihat diskusi risiko banned).
FONNTE_KEHADIRAN_AKTIF=false

# String acak (mis. `php artisan tinker --execute="echo Str::random(40);"`).
# Pasang URL /webhooks/fonnte/<nilai-ini> di dashboard Fonnte (device->edit
# ->Webhook Update Message Status) supaya status pengiriman WA (termasuk
# "state 0" -- WhatsApp menolak kirim meski API bilang sukses) tercatat
# balik ke notifikasi_absensi_log. Kosongkan untuk menonaktifkan endpoint
# ini (selalu 404).
FONNTE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# spatie/laravel-backup (lihat DEPLOYMENT.md)
BACKUP_NOTIFICATION_EMAIL=your@example.com
BACKUP_ARCHIVE_PASSWORD=
